{
  "type": "module",
  "private": "true",
  "version": "0.0.0",
  "main": "public/index.js",
  "scripts": {
    "lint": "eslint \"./**/*.{ts,js}\"",
    "build-tests": "esbuild test/index.ts --bundle --format=cjs --keep-names > test/test-bundle.js",
    "test": "npm run lint && npm run build && npm run build-tests && npm run test-tape-run",
    "test:lambdas": "concurrently --kill-others -s first \"ntl functions:serve --port=9999 --debug\" \"npx wait-on http://localhost:9999/.netlify/functions/login && npx esbuild ./test/lambdas/*.ts --bundle --format=esm | node --input-type=module | npx tap-spec\"",
    "test-tape-run": "cat test/index.html | tape-run --input=html --static=test | tap-spec",
    "build": "mkdir -p ./public && rm -rf ./public/* && vite build",
    "start": "concurrently --kill-others \"npx ntl functions:serve --port=9999 --debug\" \"npx partykit dev\" \"npx vite --mode=\"development\"\"",
    "preversion": "npm run lint",
    "version": "auto-changelog --template keepachangelog --breaking-pattern 'BREAKING CHANGE' && git add CHANGELOG.md",
    "setup-db": "esbuild ./script/dbinit.ts --platform=node --format=esm | node --input-type=module",
    "preinstall": "export $(cat .env | grep -e '^[^#]*$' | xargs)",
    "postversion": "git push --follow-tags",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@bicycle-codes/keys": "^0.1.14",
    "@bicycle-codes/message": "^0.9.1",
    "@bicycle-codes/one-webcrypto": "^1.1.2",
    "@bicycle-codes/request": "^0.6.20",
    "@hello-system/connect": "^0.0.8",
    "@neondatabase/serverless": "^1.0.0",
    "@nichoth/components": "^0.16.17",
    "@nichoth/nanoid": "^5.0.8",
    "@nichoth/nanoid-dictionary": "^5.0.7",
    "@octokit/core": "^6.1.4",
    "@preact/preset-vite": "^2.10.1",
    "@preact/signals": "^2.0.0",
    "@shoelace-style/shoelace": "^2.20.1",
    "@sindresorhus/slugify": "^2.2.1",
    "@substrate-system/a11y": "^0.0.5",
    "@substrate-system/copy-button": "^0.5.6",
    "@substrate-system/css-normalize": "^0.0.7",
    "@substrate-system/dom": "^0.1.7",
    "@substrate-system/icons": "^0.1.17",
    "@substrate-system/routes": "^5.0.2",
    "@substrate-system/util": "^0.1.25",
    "htm": "^3.1.1",
    "ky": "^1.7.4",
    "luxon": "^3.5.0",
    "marked": "^15.0.7",
    "partyserver": "^0.0.66",
    "partysocket": "1.0.3",
    "preact": "^10.25.4",
    "preact-markup": "^2.1.1",
    "resend": "^4.2.0",
    "route-event": "^6.0.9",
    "stylelint": "^16.16.0",
    "uuid": "^11.1.0",
    "vite-plugin-static-copy": "^2.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.7.5",
    "@cloudflare/workers-types": "^4.20250321.0",
    "@netlify/functions": "^3.0.1",
    "@substrate-system/debug": "^0.7.22",
    "@substrate-system/tapzero": "^0.10.13",
    "@substrate-system/wait-on": "^8.0.3",
    "@substrate-system/web-component": "^0.0.14",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.8.1",
    "auto-changelog": "^2.4.0",
    "concurrently": "^9.0.1",
    "cssnano": "^7.0.6",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.1",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "netlify-cli": "^19.0.2",
    "partykit": "0.0.111",
    "postcss-nesting": "^13.0.1",
    "prisma": "^6.5.0",
    "stylelint-config-standard": "^37.0.0",
    "tap-spec": "^5.0.0",
    "tape-run": "^11.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.1",
    "wrangler": "^4.5.0"
  },
  "author": "nichoth <nichoth@nichoth.com> (https://nichoth.com)"
}
